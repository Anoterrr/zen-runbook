# macOS toolkit. Install: brew bundle --file ~/repos/zen-runbook/packages/macos.Brewfile

# base system
brew "git"
brew "gh"
brew "curl"
brew "openssh"
brew "fzf"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "terminal-notifier"
brew "stow"

# CLI tools
brew "eza"
brew "bat"
brew "ripgrep"
brew "fd"
brew "zoxide"
brew "git-delta"
brew "starship"
brew "lazygit"
brew "neovim"
brew "tmux"
brew "topgrade"
brew "lnav"
brew "jq"
brew "yq"
brew "miller"
brew "duckdb"
brew "btop"
brew "k9s"
brew "hyperfine"
brew "pre-commit"
brew "shellcheck"
brew "uv"

# containers and local Kubernetes, which also bring docker and kubectl (setup/macos.md)
cask "rancher"

# GUI
cask "zed"
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
